# ─────────────────────────────────────────────────────────────────────────
# Frontend environment. Copy this file to `.env` and fill in real values.
#   cp .env.example .env
# Vite only exposes vars prefixed with VITE_ to the browser. On Vercel, set
# these in Project Settings → Environment Variables (not this file).
# ─────────────────────────────────────────────────────────────────────────

# --- Backend location -----------------------------------------------------
# Where the API + socket server lives. REQUIRED in production (Vercel has no
# backend). In dev it defaults to http://localhost:3000 if unset. No trailing
# slash.
VITE_BACKEND_URL=https://your-backend.onrender.com

# --- GIF picker, Giphy (optional) -----------------------------------------
# Get a free key at https://developers.giphy.com. Without it the GIF picker
# won't return results.
VITE_GIPHY_API_KEY=your-giphy-api-key

# --- TURN server for calls (optional, recommended) ------------------------
# A free built-in TURN server (Open Relay) is always used, so calls work
# without this. For better reliability sign up free at https://metered.ca
# (20 GB/month, no card) and set all three — they're added on TOP of the
# built-in one, not instead of it.
VITE_TURN_URL=turn:your-turn-host:443
VITE_TURN_USERNAME=your-turn-username
VITE_TURN_CREDENTIAL=your-turn-credential
