{
  "expo": {
    "name": "Havn",
    "slug": "havn",
    "scheme": "havn",
    "version": "1.0.0",
    "orientation": "default",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "icon": "./assets/icon.png",
    "plugins": [
      "expo-router",
      [
        "expo-camera",
        {
          "cameraPermission": "Allow Havn to scan a web login QR code."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow Havn to choose a photo to send in chat."
        }
      ],
      [
        "expo-notifications",
        {
          "defaultChannel": "messages",
          "color": "#C2410C"
        }
      ],
      "expo-video",
      [
        "expo-audio",
        {
          "microphonePermission": "Havn needs the microphone to record voice messages."
        }
      ],
      "expo-web-browser",
      "expo-font",
      "@react-native-firebase/app",
      "@config-plugins/react-native-webrtc",
      ["expo-build-properties", { "android": { "minSdkVersion": 24 } }]
    ],
    "experiments": {
      "typedRoutes": false
    },
    "android": {
      "package": "com.kairosva.havn",
      "softwareKeyboardLayoutMode": "resize",
      "googleServicesFile": "./google-services.json",
      "permissions": [
        "CAMERA",
        "RECORD_AUDIO",
        "MODIFY_AUDIO_SETTINGS",
        "USE_FULL_SCREEN_INTENT",
        "POST_NOTIFICATIONS",
        "WAKE_LOCK",
        "FOREGROUND_SERVICE",
        "FOREGROUND_SERVICE_MICROPHONE",
        "FOREGROUND_SERVICE_CAMERA",
        "BLUETOOTH_CONNECT",
        "REQUEST_IGNORE_BATTERY_OPTIMIZATIONS"
      ],
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#FAF7F2"
      },
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            {
              "scheme": "https",
              "host": "havn.kairos-va.com",
              "pathPrefix": "/u/"
            },
            {
              "scheme": "https",
              "host": "havn.kairos-va.com",
              "pathPrefix": "/qr/"
            }
          ],
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ]
        }
      ]
    },
    "extra": {
      "router": {
        "asyncRoutes": {
          "web": true
        }
      },
      "eas": {
        "projectId": "471c59b0-a58a-490f-9308-efacf1d2edaa"
      }
    }
  }
}